diff --git a/src/lib/achievements.js b/src/lib/achievements.js
new file mode 100644
index 0000000..464f80f
--- /dev/null
+++ b/src/lib/achievements.js
@@ -0,0 +1,76 @@
+const POKER_GAMES = new Set([
+  'texas-holdem', 'jacks-or-better', 'bonus-poker', 'double-bonus-poker',
+  'double-double-bonus-poker', 'deuces-wild', 'joker-poker',
+]);
+const SOLITAIRE_GAMES = new Set(['klondike', 'spider', 'freecell', 'tripeaks', 'pyramid']);
+const CLASSIC_GAMES = new Set(['spades', 'hearts', 'gin-rummy']);
+const FAMILY_GAMES = new Set(['crazy-eights', 'go-fish', 'war', 'speed', 'color-clash']);
+
+function rows(progress) {
+  return Object.entries(progress?.games || {});
+}
+function totalPlays(progress) {
+  return rows(progress).reduce((sum, [, game]) => sum + Number(game?.plays || 0), 0);
+}
+function totalWins(progress) {
+  return rows(progress).reduce((sum, [, game]) => sum + Number(game?.wins || 0), 0);
+}
+function tutorialCount(progress) {
+  return rows(progress).filter(([, game]) => Boolean(game?.tutorialComplete)).length;
+}
+function playedDistinct(progress, set = null) {
+  return rows(progress).filter(([id, game]) => (!set || set.has(id)) && Number(game?.plays || 0) > 0).length;
+}
+function totalDecisions(progress) {
+  return rows(progress).reduce((sum, [, game]) => sum + Number(game?.totalDecisions || 0), 0);
+}
+function correctDecisions(progress) {
+  return rows(progress).reduce((sum, [, game]) => sum + Number(game?.correctDecisions || 0), 0);
+}
+function anyGame(progress, predicate) {
+  return rows(progress).some(([id, game]) => predicate(game || {}, id));
+}
+function winsAcross(progress, set) {
+  return rows(progress).reduce((sum, [id, game]) => sum + (set.has(id) ? Number(game?.wins || 0) : 0), 0);
+}
+
+export const ACHIEVEMENTS = [
+  { id:'first-game', title:'First Deal', description:'Complete your first Card Academy game.', test:p=>totalPlays(p)>=1 },
+  { id:'first-win', title:'First Table Win', description:'Win your first complete game.', test:p=>totalWins(p)>=1 },
+  { id:'first-tutorial', title:'Lesson One', description:'Complete your first guided tutorial.', test:p=>tutorialCount(p)>=1 },
+  { id:'blackjack-scholar', title:'Blackjack Scholar', description:'Graduate from the Blackjack tutorial.', test:p=>Boolean(p.games?.blackjack?.tutorialComplete) },
+  { id:'holdem-student', title:'Hold’em Student', description:'Graduate from the Texas Hold’em tutorial.', test:p=>Boolean(p.games?.['texas-holdem']?.tutorialComplete) },
+  { id:'spades-strategist', title:'Spades Strategist', description:'Win three games of Spades.', test:p=>Number(p.games?.spades?.wins||0)>=3 },
+  { id:'heartbreaker', title:'Heartbreaker', description:'Win a complete game of Hearts.', test:p=>Number(p.games?.hearts?.wins||0)>=1 },
+  { id:'solitaire-solver', title:'Solitaire Solver', description:'Win any Solitaire-family game.', test:p=>winsAcross(p,SOLITAIRE_GAMES)>=1 },
+  { id:'perfect-ten', title:'Perfect Ten', description:'Make ten correct coached decisions in a row.', test:p=>anyGame(p,g=>Number(g.bestDecisionStreak||0)>=10) },
+  { id:'seven-day-streak', title:'Seven-Day Streak', description:'Learn or play on seven consecutive days.', test:p=>Number(p.streak?.days||0)>=7 },
+  { id:'five-game-explorer', title:'Five-Game Explorer', description:'Play five different Card Academy games.', test:p=>playedDistinct(p)>=5 },
+  { id:'poker-tour', title:'Poker Tour', description:'Play three different Poker-family games.', test:p=>playedDistinct(p,POKER_GAMES)>=3 },
+  { id:'solitaire-explorer', title:'Solitaire Explorer', description:'Play three different Solitaire-family games.', test:p=>playedDistinct(p,SOLITAIRE_GAMES)>=3 },
+  { id:'classic-regular', title:'Classic Regular', description:'Complete ten games across Spades, Hearts, and Gin Rummy.', test:p=>rows(p).reduce((s,[id,g])=>s+(CLASSIC_GAMES.has(id)?Number(g?.plays||0):0),0)>=10 },
+  { id:'family-night', title:'Family Night', description:'Play three different Family-table games.', test:p=>playedDistinct(p,FAMILY_GAMES)>=3 },
+  { id:'academy-graduate', title:'Academy Graduate', description:'Complete tutorials for five different games.', test:p=>tutorialCount(p)>=5 },
+  { id:'table-hopper', title:'Table Hopper', description:'Play ten different games in the Academy.', test:p=>playedDistinct(p)>=10 },
+  { id:'hundred-decisions', title:'Hundred Decisions', description:'Make one hundred coached decisions.', test:p=>totalDecisions(p)>=100 },
+  { id:'sharp-reader', title:'Sharp Reader', description:'Make at least fifty correct coached decisions.', test:p=>correctDecisions(p)>=50 },
+  { id:'cardwise-master', title:'CardWise Master', description:'Earn 5,000 Card Academy XP and complete five tutorials.', test:p=>Number(p.totalXp||0)>=5000 && tutorialCount(p)>=5 },
+];
+
+export const ACHIEVEMENT_BY_ID = Object.fromEntries(ACHIEVEMENTS.map(item => [item.id, item]));
+
+export function evaluateAchievements(progress, at = new Date().toISOString()) {
+  const existing = { ...(progress?.achievements || {}) };
+  const newlyUnlocked = [];
+  for (const achievement of ACHIEVEMENTS) {
+    if (existing[achievement.id]) continue;
+    if (achievement.test(progress)) {
+      existing[achievement.id] = at;
+      newlyUnlocked.push(achievement.id);
+    }
+  }
+  return {
+    progress: { ...progress, achievements: existing },
+    newlyUnlocked,
+  };
+}
