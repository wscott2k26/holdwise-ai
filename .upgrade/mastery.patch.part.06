   const [premium, setPremium] = useState({ status: "free", platform: null, productId: null, verified: false });
   const [coachUsage, setCoachUsage] = useState(() => {
     const saved = persisted?.coachUsage;
diff --git a/src/lib/cardAcademyProgress.js b/src/lib/cardAcademyProgress.js
index 9d9bea9..a87fd7e 100644
--- a/src/lib/cardAcademyProgress.js
+++ b/src/lib/cardAcademyProgress.js
@@ -1,14 +1,219 @@
-export const CARD_ACADEMY_PROGRESS_KEY='holdwise_card_academy_progress_v1';
-const empty=()=>({games:{},families:{},recentGames:[],totalXp:0});
-function normalized(raw){ return raw&&typeof raw==='object'?{...empty(),...raw,games:{...(raw.games||{})},families:{...(raw.families||{})},recentGames:Array.isArray(raw.recentGames)?raw.recentGames:[]}:empty(); }
-export function loadCardAcademyProgress(storage=globalThis.localStorage){ if(!storage)return empty(); try{return normalized(JSON.parse(storage.getItem(CARD_ACADEMY_PROGRESS_KEY)||'null'));}catch{return empty();} }
-function save(p,storage){ storage?.setItem(CARD_ACADEMY_PROGRESS_KEY,JSON.stringify(p)); return p; }
-function gameRow(p,id){ return p.games[id]||{plays:0,wins:0,tutorialComplete:false,xp:0}; }
-function familyRow(p,id){ return p.families[id]||{plays:0,wins:0,tutorials:0,xp:0}; }
-function touchRecent(p,id){ p.recentGames=[id,...p.recentGames.filter(x=>x!==id)].slice(0,8); }
-export function markTutorialComplete(gameId,{family='other',xp=100}={},storage=globalThis.localStorage,at=new Date().toISOString()){
-  const p=loadCardAcademyProgress(storage), g=gameRow(p,gameId), f=familyRow(p,family); const first=!g.tutorialComplete; p.games[gameId]={...g,tutorialComplete:true,tutorialCompletedAt:g.tutorialCompletedAt||at,xp:g.xp+(first?xp:0)}; if(first){f.tutorials+=1;f.xp+=xp;p.totalXp+=xp;} p.families[family]=f; touchRecent(p,gameId); return save(p,storage);
-}
-export function recordGameResult(gameId,{family='other',won=false,xp=0}={},storage=globalThis.localStorage,at=new Date().toISOString()){
-  const p=loadCardAcademyProgress(storage),g=gameRow(p,gameId),f=familyRow(p,family); p.games[gameId]={...g,plays:g.plays+1,wins:g.wins+(won?1:0),xp:g.xp+xp,lastPlayedAt:at}; f.plays+=1;f.wins+=won?1:0;f.xp+=xp;p.families[family]=f;p.totalXp+=xp;touchRecent(p,gameId);return save(p,storage);
+import { evaluateAchievements } from './achievements.js';
+
+export const CARD_ACADEMY_PROGRESS_KEY = 'holdwise_card_academy_progress_v1';
+export const CARD_ACADEMY_SCHEMA_VERSION = 2;
+
+const empty = () => ({
+  schemaVersion: CARD_ACADEMY_SCHEMA_VERSION,
+  games: {},
+  families: {},
+  recentGames: [],
+  totalXp: 0,
+  achievements: {},
+  streak: { days: 0, lastActiveDate: null },
+  dailyRewards: {},
+});
+
+function normalizeGameRow(row = {}) {
+  const totalDecisions = Math.max(0, Number(row.totalDecisions || 0));
+  const correctDecisions = Math.max(0, Math.min(totalDecisions, Number(row.correctDecisions || 0)));
+  const accuracyScore = totalDecisions > 0 ? Math.round((correctDecisions / totalDecisions) * 100) : 0;
+  return {
+    plays: Math.max(0, Number(row.plays || 0)),
+    wins: Math.max(0, Number(row.wins || 0)),
+    tutorialComplete: Boolean(row.tutorialComplete),
+    xp: Math.max(0, Number(row.xp || 0)),
+    correctDecisions,
+    totalDecisions,
+    accuracyScore,
+    currentDecisionStreak: Math.max(0, Number(row.currentDecisionStreak || 0)),
+    bestDecisionStreak: Math.max(0, Number(row.bestDecisionStreak || 0)),
+    ...(row.tutorialCompletedAt ? { tutorialCompletedAt: row.tutorialCompletedAt } : {}),
+    ...(row.lastPlayedAt ? { lastPlayedAt: row.lastPlayedAt } : {}),
+    ...(row.lastDecisionAt ? { lastDecisionAt: row.lastDecisionAt } : {}),
+  };
+}
+
+function normalizeFamilyRow(row = {}) {
+  return {
+    plays: Math.max(0, Number(row.plays || 0)),
+    wins: Math.max(0, Number(row.wins || 0)),
+    tutorials: Math.max(0, Number(row.tutorials || 0)),
+    xp: Math.max(0, Number(row.xp || 0)),
+  };
+}
+
+function normalized(raw) {
+  if (!raw || typeof raw !== 'object') return empty();
+  const games = Object.fromEntries(Object.entries(raw.games || {}).map(([id, row]) => [id, normalizeGameRow(row)]));
+  const families = Object.fromEntries(Object.entries(raw.families || {}).map(([id, row]) => [id, normalizeFamilyRow(row)]));
+  const achievements = raw.achievements && typeof raw.achievements === 'object' && !Array.isArray(raw.achievements)
+    ? { ...raw.achievements }
+    : Object.fromEntries((Array.isArray(raw.achievements) ? raw.achievements : []).map(id => [id, raw.updatedAt || new Date(0).toISOString()]));
+  const streak = raw.streak && typeof raw.streak === 'object'
+    ? { days: Math.max(0, Number(raw.streak.days || 0)), lastActiveDate: raw.streak.lastActiveDate || null }
+    : { days: Math.max(0, Number(raw.streakDays || 0)), lastActiveDate: raw.lastPlayedDate || null };
+  return {
+    ...empty(),
+    ...raw,
+    schemaVersion: CARD_ACADEMY_SCHEMA_VERSION,
+    games,
+    families,
+    recentGames: Array.isArray(raw.recentGames) ? [...new Set(raw.recentGames.filter(Boolean))].slice(0, 8) : [],
+    totalXp: Math.max(0, Number(raw.totalXp || 0)),
+    achievements,
+    streak,
+    dailyRewards: raw.dailyRewards && typeof raw.dailyRewards === 'object' ? { ...raw.dailyRewards } : {},
+  };
+}
+
+export function loadCardAcademyProgress(storage = globalThis.localStorage) {
+  if (!storage) return empty();
+  try {
+    return normalized(JSON.parse(storage.getItem(CARD_ACADEMY_PROGRESS_KEY) || 'null'));
+  } catch {
+    return empty();
+  }
+
+function save(progress, storage) {
+  storage?.setItem(CARD_ACADEMY_PROGRESS_KEY, JSON.stringify(progress));
+  return progress;
+}
+
+function gameRow(progress, id) {
+  return normalizeGameRow(progress.games[id]);
+}
+function familyRow(progress, id) {
+  return normalizeFamilyRow(progress.families[id]);
+}
+function touchRecent(progress, id) {
