   function commit(action){const previous=state;let next=engine.applyAction(state,action);if(id==='crazy-eights')next=driveCrazy(next);if(id==='go-fish')next=driveFish(next);if(id==='speed')next=driveSpeedBot(next,{maxActions:160});if(id==='color-clash')next=driveColor(next);record(previous,next);setState(next);}
   function nextRound(){let next=id==='crazy-eights'?startNextCrazyEightsRound(state):startNextColorClashRound(state);next=id==='crazy-eights'?driveCrazy(next):driveColor(next);setState(next);}
