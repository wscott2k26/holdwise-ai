 function FishBoard({state,commit}){
   const [rank,setRank]=useState(state.players[HUMAN].hand[0]?.rank||'A'),[target,setTarget]=useState(1);const legal=useMemo(()=>goFishEngine.legalActions(state,HUMAN),[state]);const ranks=[...new Set(state.players[HUMAN].hand.map(c=>c.rank))];React.useEffect(()=>{if(!ranks.includes(rank)&&ranks.length)setRank(ranks[0]);},[state]);const ask=legal.find(a=>a.type==='ask'&&a.rank===rank&&a.target===target);
-  return <div><Opponents players={state.players} actor={state.actor} extra={p=>`${p.books} book${p.books===1?'':'s'}`}/><div className="my-5 grid grid-cols-2 gap-3"><GlassSurface strength={2} className="rounded-2xl p-3 text-center"><Fish className="mx-auto hw-family-gold"/><p className="mt-1 text-[9px] uppercase tracking-[.15em] text-white/40">Pond</p><p className="text-xl font-black text-white">{state.stock.length}</p></GlassSurface><GlassSurface strength={2} className="rounded-2xl p-3 text-center"><Trophy className="mx-auto hw-family-gold"/><p className="mt-1 text-[9px] uppercase tracking-[.15em] text-white/40">Your books</p><p className="text-xl font-black text-white">{state.players[HUMAN].books}</p></GlassSurface></div><div className="flex overflow-x-auto pb-3"><div className="flex min-w-max -space-x-6 px-5">{state.players[HUMAN].hand.map(card=><PlayingCard key={card.id} card={card} selected={card.rank===rank} onClick={()=>setRank(card.rank)}/>)}</div></div><div className="mt-3"><p className="text-[9px] font-black uppercase tracking-[.15em] text-white/40">Ask for rank {rank}</p><div className="mt-2 grid grid-cols-3 gap-2">{[1,2,3].map(seat=><TactilePressable key={seat} onClick={()=>setTarget(seat)} className={`rounded-xl py-2 text-xs font-black ${target===seat?'bg-[hsl(var(--hw-gold))] text-[hsl(var(--hw-navy))]':'bg-white/6 text-white shadow-none'}`}>Player {seat+1}</TactilePressable>)}</div><TactilePressable disabled={!ask} onClick={()=>ask&&commit(ask)} className="mt-3 w-full rounded-2xl bg-[hsl(var(--hw-gold))] py-3 font-black text-[hsl(var(--hw-navy))]">Go Fish · Ask {rank}</TactilePressable>{state.lastEvent&&<p className="mt-2 text-center text-xs text-white/45">{state.lastEvent.type==='got-cards'?`Got ${state.lastEvent.count} card${state.lastEvent.count===1?'':'s'}!`:state.lastEvent.luckyFish?'Lucky fish — you drew the rank you asked for!':'Go Fish.'}</p>}</div></div>;
