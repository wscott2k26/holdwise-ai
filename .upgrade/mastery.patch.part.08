+      explanation: 'The correct choice is derived from the live Klondike engine. Tableau builds downward in alternating colors, and only Kings may enter empty tableau columns.',
+    };
+  }
+
+  return null;
+}
+
+export function isTutorialDecisionCorrect(decision, value) {
+  if (!decision) return false;
+  const accepted = decision.correctOptions?.length ? decision.correctOptions : [decision.correctAction];
+  return accepted.includes(value);
+}
