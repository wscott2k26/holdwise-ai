{
  "name": "holdwise-ai",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "test:core": "node --test tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "npm run test:core && npm run validate:content",
    "qa": "npm run test && npm run lint && npm run typecheck && npm run build",
    "build:native": "VITE_NATIVE_IOS=true vite build",
    "ios:prepare": "bash native/ios/HoldWiseAI/Scripts/prepare_web.sh",
    "ios:project": "bash native/ios/HoldWiseAI/Scripts/bootstrap.sh",
    "ios:archive": "bash native/ios/HoldWiseAI/Scripts/archive.sh",
    "ios:upload": "bash native/ios/HoldWiseAI/Scripts/upload_testflight.sh",
    "ios:release": "bash native/ios/HoldWiseAI/Scripts/release_all.sh",
    "appstore:verify": "python3 apple/verify_app_store_connect.py",
    "release:verify": "node scripts/verify-cloud-release.mjs && node scripts/verify-one-click-release.mjs",
    "ios:eas": "eas build --platform ios --profile production --auto-submit"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.40",
    "@base44/vite-plugin": "^1.0.30",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@tanstack/react-query": "^5.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.16.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0"
  }
}
